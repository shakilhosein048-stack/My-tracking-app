<!DOCTYPE html><html lang="bn"><head>    <meta charset="UTF-8">    <meta name="viewport" content="width=device-width, initial-scale=1.0">    <title>জার্নি ট্র্যাকার প্রো - শাকিল</title>        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />        <style>        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }        body { background-color: #f0f2f5; padding: 15px; display: flex; flex-direction: column; align-items: center; }                .header { text-align: center; margin-bottom: 20px; }        .logo { font-size: 40px; }        h2 { font-size: 24px; color: #1a1a1a; }        .card { background: white; border-radius: 15px; padding: 20px; width: 100%; max-width: 450px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); margin-bottom: 20px; }                /* Stats Styling */        .stats-grid { display: flex; justify-content: space-between; gap: 10px; margin-bottom: 15px; }        .stat-box { background: #f8f9fa; padding: 15px; border-radius: 12px; width: 48%; text-align: center; border-top: 4px solid #007bff; }        .stat-value { font-size: 28px; font-weight: bold; color: #007bff; }        .stat-label { font-size: 12px; color: #666; }        /* Map Styling */        #map { height: 200px; width: 100%; border-radius: 10px; margin-bottom: 15px; border: 1px solid #ddd; }        /* Calculator Styling */        .calc-title { font-size: 16px; font-weight: bold; margin-bottom: 10px; color: #333; border-bottom: 1px solid #eee; padding-bottom: 5px; }        input { width: 100%; padding: 10px; margin: 8px 0; border: 1px solid #ddd; border-radius: 8px; font-size: 16px; }                .btn { width: 100%; padding: 15px; border: none; border-radius: 10px; font-size: 16px; font-weight: bold; cursor: pointer; transition: 0.3s; margin-top: 10px; }        .btn-start { background: #007bff; color: white; }        .btn-stop { background: #dc3545; color: white; }        .btn-calc { background: #28a745; color: white; }        #result { margin-top: 10px; padding: 10px; background: #e9f7ef; border-radius: 8px; color: #155724; font-weight: bold; text-align: center; display: none; }    </style></head><body><div class="header">    <div class="logo">🚀</div>    <h2>জার্নি ট্র্যাকার প্রো</h2>    <p style="font-size: 12px; color: #777;">শাকিল হোসেন দ্বারা তৈরি</p></div><div class="card">    <div class="calc-title">🛰️ লাইভ ট্র্যাকিং মিটার</div>    <div class="stats-grid">        <div class="stat-box">            <div class="stat-value" id="liveSpeed">0.0</div>            <div class="stat-label">বর্তমান গতি (km/h)</div>        </div>        <div class="stat-box">            <div class="stat-value" id="liveDist">0.00</div>            <div class="stat-label">মোট দূরত্ব (km)</div>        </div>    </div>        <div id="map"></div>        <button id="trackBtn" class="btn btn-start" onclick="toggleTracking()">ট্র্যাকিং শুরু করুন</button></div><div class="card">    <div class="calc-title">⚖️ ম্যানুয়াল গতি ক্যালকুলেটর</div>    <input type="number" id="inputDist" placeholder="মোট দূরত্ব (কিমি)">    <input type="number" id="inputTime" placeholder="মোট সময় (মিনিট)">    <button class="btn btn-calc" onclick="calculateSpeed()">হিসাব করুন</button>    <div id="result"></div></div><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script>    let isTracking = false;    let watchId = null;    let totalDistance = 0;    let lastPos = null;    let map = L.map('map').setView([23.8103, 90.4125], 13);    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);    let marker = L.marker([23.8103, 90.4125]).addTo(map);    function toggleTracking() {        const btn = document.getElementById('trackBtn');        if (!isTracking) {            if (navigator.geolocation) {                watchId = navigator.geolocation.watchPosition(updateStats, handleError, {enableHighAccuracy: true});                isTracking = true;                btn.innerText = "ট্র্যাকিং বন্ধ করুন";                btn.className = "btn btn-stop";            }        } else {            navigator.geolocation.clearWatch(watchId);            isTracking = false;            btn.innerText = "ট্র্যাকিং শুরু করুন";            btn.className = "btn btn-start";            document.getElementById('liveSpeed').innerText = "0.0";        }    }    function updateStats(pos) {        const lat = pos.coords.latitude;        const lon = pos.coords.longitude;        const speed = pos.coords.speed ? (pos.coords.speed * 3.6).toFixed(1) : 0.0;                document.getElementById('liveSpeed').innerText = speed;                const currentPos = L.latLng(lat, lon);        marker.setLatLng(currentPos);        map.setView(currentPos, 16);        if (lastPos) {            const d = map.distance(lastPos, currentPos) / 1000;            if (d > 0.002) {                totalDistance += d;                document.getElementById('liveDist').innerText = totalDistance.toFixed(2);            }        }        lastPos = currentPos;    }    function calculateSpeed() {        const d = document.getElementById('inputDist').value;        const t = document.getElementById('inputTime').value;        const res = document.getElementById('result');        if (d > 0 && t > 0) {            const speed = (d / (t / 60)).toFixed(2);            res.style.display = "block";            res.innerText = "আপনার গতি: " + speed + " কিমি/ঘণ্টা";        }    }    function handleError(err) {        alert("লোকেশন পারমিশন প্রয়োজন। দয়া করে GPS অন করুন।");    }</script></body></html>